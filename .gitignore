# ---------------------------------------------
# Secrets & environment  (MOST IMPORTANT)
# ---------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template

# Supabase edge function secrets
supabase/.env
supabase/functions/**/.env

# Keys / certs — never commit
*.pem
*.key
*.p8
*.p12
*.pfx
*.crt
service-account*.json

